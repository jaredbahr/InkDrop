# Public Docker image build context.
#
# Default-deny the homelab workspace. Docker sends every unignored file to the
# daemon before COPY runs, so keep the context focused on InkDrop runtime code
# and the one runtime catalog artifact.
*

!/Dockerfile
!/requirements.txt
!/inkdrop-logo-mark.png
!/web/
!/web/static/
!/web/static/css/
!/web/static/css/inkdrop.css
!/web/static/img/
!/web/static/img/inkdrop-auth-backdrop.webp
!/web/static/js/
!/web/static/js/*.js
# Browser regressions remain in Git/CI but are not production runtime inputs.
/web/tests/
# Frontend source only -- the frontend-builder Docker stage compiles this
# into web/static/dist, which is never part of the build context itself
# (it's produced inside the image, then copied stage-to-stage).
!/web/frontend/
!/web/frontend/package.json
!/web/frontend/package-lock.json
!/web/frontend/tsconfig.json
!/web/frontend/vite.config.ts
!/web/frontend/index.html
!/web/frontend/src/
!/web/frontend/src/*.tsx
!/web/frontend/src/*.ts
!/web/frontend/src/sections/
!/web/frontend/src/sections/*.tsx
!/web/frontend/src/sections/*.ts
# A directory-level `!` above does not stop later patterns from re-excluding
# what's inside it -- explicit belts-and-braces, since a locally-installed
# node_modules/ here is 100+ MB and must never reach the build context (the
# frontend-builder stage installs its own via `npm ci` from the lockfile).
/web/frontend/node_modules/
/web/frontend/dist/
!/inkdrop-completion-identity-audit-diff-alert.sh
!/inkdrop-completion-identity-audit-diff-check.sh
!/inkdrop-import-ready-worker.sh
!/inkdrop-series-autopilot-cron.sh
!/inkdrop-source-worker-mangadex-cron.sh
!/inkdrop-source-worker-suwayomi-cron.sh
!/inkdrop-source-worker.sh
!/inkdrop-state-path-contract-sync-regression-alert.sh
