# InkDrop closed-alpha example config.
# Optional: copy to .env before running `docker compose up -d` when you want
# to configure providers, paths, or automation knobs.

INKDROP_HOST=0.0.0.0
# Browser-facing host port. Change this, then recreate both InkDrop services.
INKDROP_HOST_PORT=8796
# Internal container bind port. Most Docker users should leave this unchanged.
INKDROP_PORT=8796

# Build identity. Release builds should use a semantic tag such as
# v0.1.0-alpha.1, the full Git commit SHA, and an ISO 8601 UTC build date.
# Local builds remain visibly development builds when these are unchanged.
INKDROP_VERSION=dev
INKDROP_COMMIT_SHA=unknown
INKDROP_BUILD_DATE=unknown
INKDROP_CANDIDATE_MANIFEST_PATH=/state/release/current.json
INKDROP_RELEASE_CHANNEL=dev
# CI sets this from github.run_number for QA images; local/dev builds use 0.
INKDROP_QA_BUILD_NUMBER=0

INKDROP_CONFIG_DIR=/config
INKDROP_STATE_DIR=/state
INKDROP_LOCK_DIR=/state/locks
INKDROP_LOG_DIR=/state/logs
INKDROP_LOG_ROTATION_MAX_BYTES=67108864
INKDROP_LOG_RETENTION_FILES=5
INKDROP_LOG_RETENTION_DAYS=14
INKDROP_LOG_RETENTION_WRITER_GRACE_SECONDS=7200
INKDROP_LOG_ROTATION_QUIET_SECONDS=60
INKDROP_LOG_ROTATION_SAMPLE_MILLISECONDS=100
INKDROP_CACHE_DIR=/state/cache
INKDROP_BACKUP_DIR=/state/backups
INKDROP_STAGING_DIR=/staging
INKDROP_MANUAL_INBOX_DIR=/manual-inbox
INKDROP_QUARANTINE_DIR=/state/quarantine

INKDROP_COMIC_ROOT=/library/comics
INKDROP_MANGA_ROOT=/library/manga
INKDROP_MANUAL_COMICS_INBOX=/manual-inbox/comics
INKDROP_MANUAL_EBOOKS_INBOX=/manual-inbox/ebooks
INKDROP_SLSKD_DOWNLOAD_ROOT=/staging/slskd
INKDROP_UNMATCHED_DOWNLOAD_ROOT=/staging/downloads/comics
INKDROP_DIRECT_DOWNLOAD_ROOT=/staging/direct/comics
INKDROP_PACK_DOWNLOAD_ROOT=/staging/downloads/comics
INKDROP_PACK_TEMP_DOWNLOAD_ROOT=/staging/temp/downloads/comics
INKDROP_EBOOK_DOWNLOAD_ROOT=/staging/ebooks
INKDROP_SUWAYOMI_STAGING_ROOT=/staging/suwayomi
INKDROP_SUWAYOMI_API_BASE_URL=
INKDROP_SOURCE_WORKER_STAGING_ROOT=/staging/source-worker
INKDROP_UNMATCHED_QUARANTINE_ROOT=/state/quarantine/unmatched
INKDROP_MANAGED_DUPLICATE_QUARANTINE_ROOT=/state/quarantine/managed-duplicate-files
INKDROP_PACK_DUPLICATE_QUARANTINE_ROOT=/state/quarantine/pack-duplicates
INKDROP_PACK_REVIEW_QUARANTINE_ROOT=/state/quarantine/pack-review
INKDROP_COMIC_INCOMING_ROOT=/library/comics/_Incoming
INKDROP_EBOOK_INCOMING_ROOT=/library/ebooks/_Incoming

# Automation/source policy. Keep conservative unless you know why to tune it.
INKDROP_PROTOCOL_ORDER=usenet,torrent,direct
INKDROP_QUEUE_RUNNER_AUTOPILOT_ENABLED=0
# Recovery is separately opt-in and never enables ordinary Automatic Search.
INKDROP_MISSING_RECOVERY_ENABLED=0
INKDROP_MISSING_RECOVERY_MAX_PER_COHORT=2
INKDROP_MISSING_RECOVERY_MAX_HANDOFFS_PER_HOUR=5
INKDROP_MISSING_RECOVERY_MAX_BYTES_PER_HOUR=10737418240
INKDROP_MISSING_RECOVERY_MAX_BYTES_PER_DAY=32212254720
INKDROP_MISSING_RECOVERY_MIN_STAGING_FREE_BYTES=5368709120
INKDROP_MISSING_RECOVERY_PAUSE_AFTER_FAILURES=3
# Optional local-time range such as 22:00-06:00. Blank means no quiet hours.
INKDROP_MISSING_RECOVERY_QUIET_HOURS=
INKDROP_QUEUE_RUNNER_IMPORT_PRIORITY_READY_IMPORTS=1
INKDROP_SERIES_AUTOPILOT_MAX_RUN_SECONDS=480
INKDROP_SERIES_AUTOPILOT_OUTER_TIMEOUT_SECONDS=570
INKDROP_SERIES_AUTOPILOT_TIMEOUT_KILL_AFTER_SECONDS=30
# Comma-separated source-worker protection minutes. Use "none" to disable capping.
INKDROP_SERIES_AUTOPILOT_PROTECTED_MINUTES=1,16,31,46
INKDROP_SERIES_AUTOPILOT_PROTECTED_RESERVE_SECONDS=60
INKDROP_AUTOPILOT_RUNTIME_HARD_GRACE_SECONDS=90
INKDROP_IMPORT_READY_QUEUE_ONLY=0
INKDROP_IMPORT_READY_IMPORT_TIMEOUT_SECONDS=240
INKDROP_IMPORT_READY_BATCH_TIMEOUT_SECONDS=600
INKDROP_PACK_MANIFEST_CACHE_SECONDS=21600
INKDROP_RECONCILED_IMPORT_SYNC_BUDGET_SECONDS=20
INKDROP_MANGA_COMPLETION_BACKFILL_LIMIT=50
INKDROP_PACK_PROBE_SCAN_SECONDS=2
INKDROP_PACK_PROBE_SCAN_ENTRIES=20000
INKDROP_STATE_ENDPOINT_CONCURRENCY=2
INKDROP_WEB_SOCKET_TIMEOUT_SECONDS=30
# Off by default. Enable briefly only while diagnosing stuck web requests.
INKDROP_DEBUG_ACTIVE_REQUESTS=0

# On by default: whichever service you start runs the scheduler beside the
# web server, so a single-container install actually searches, downloads,
# and does maintenance instead of just serving a UI nothing feeds. Also
# running the separate inkdrop-worker service from docker-compose.yml is
# fine -- per-job file locks make the redundant scheduler skip rather than
# double-run. Set this to 0 on a web-only service if you'd rather scheduling
# live only in a dedicated worker.
INKDROP_CONTAINER_SCHEDULER_ENABLED=1
# Leave blank to derive http://inkdrop:${INKDROP_PORT} inside Compose.
INKDROP_CONTAINER_WEB_BASE_URL=
# Optional authenticated HTTP callback key (read + acquisition scopes).
# Leave blank for the default trusted in-process worker dispatch.
INKDROP_WORKER_API_KEY=
INKDROP_WORKER_STATUS_FILE=/state/worker-scheduler-status.json
INKDROP_SCHEDULER_MAX_CONCURRENCY=3
INKDROP_SCHEDULER_HEARTBEAT_SECONDS=10
INKDROP_SCHEDULER_FAILURE_BACKOFF_MAX_SECONDS=3600
INKDROP_WORKER_HEALTH_MAX_AGE_SECONDS=90
INKDROP_WORKER_HEALTH_MAX_LATENESS_SECONDS=600
INKDROP_WORKER_CRITICAL_FAILURE_THRESHOLD=3
INKDROP_SCHEDULER_STATUS_REFRESH_INTERVAL_SECONDS=120
INKDROP_SCHEDULER_QUEUE_MAINTENANCE_INTERVAL_SECONDS=180
INKDROP_SCHEDULER_QUEUE_MAINTENANCE_TIMEOUT_SECONDS=180
INKDROP_SCHEDULER_LOG_RETENTION_INTERVAL_SECONDS=300
INKDROP_SCHEDULER_LOG_RETENTION_TIMEOUT_SECONDS=120
INKDROP_SCHEDULER_COMPLETED_IMPORT_COMICS_INTERVAL_SECONDS=900
INKDROP_SCHEDULER_IMPORT_READY_INTERVAL_SECONDS=900
INKDROP_SCHEDULER_SERIES_AUTOPILOT_INTERVAL_SECONDS=900
INKDROP_SCHEDULER_SOURCE_WORKER_INTERVAL_SECONDS=1800
INKDROP_SCHEDULER_SUWAYOMI_WORKER_INTERVAL_SECONDS=1800
INKDROP_SCHEDULER_SLSKD_SEARCH_CLEANUP_INTERVAL_SECONDS=3600
INKDROP_SCHEDULER_FULL_RECONCILIATION_INTERVAL_SECONDS=21600

# Closed-alpha default: require the first administrator to bootstrap built-in
# authentication. Modes: built_in, external, built_in_or_external, disabled.
INKDROP_AUTH_MODE=built_in
# Optional bootstrap override. Blank uses InkDrop's public default of 8.
INKDROP_PASSWORD_MIN_LENGTH=
INKDROP_AUTH_SESSION_TTL_SECONDS=43200
INKDROP_AUTH_COOKIE_SECURE=auto
INKDROP_AUTH_ALLOWED_ORIGINS=
# Disabled mode is rejected unless both flags explicitly acknowledge trusted
# LAN testing. Do not use these for internet-exposed installations.
INKDROP_AUTH_ALLOW_DISABLED=0
INKDROP_TRUSTED_LAN_TESTING=0
# Legacy compatibility only. INKDROP_AUTH_MODE takes precedence.
INKDROP_AUTH_REQUIRED=1
# External identity headers are ignored unless the connecting address belongs
# to one of these explicitly trusted proxy CIDRs.
INKDROP_EXTERNAL_AUTH_ENABLED=0
INKDROP_EXTERNAL_AUTH_HEADER=X-Forwarded-User
INKDROP_EXTERNAL_AUTH_TRUSTED_PROXIES=
INKDROP_EXTERNAL_AUTH_GROUP_HEADER=
INKDROP_EXTERNAL_AUTH_ADMIN_GROUP=

# Optional adapters. Leave blank or disabled for local-folder/manual-inbox mode.
INKDROP_COMICVINE_API_KEY=
INKDROP_KAVITA_URL=
INKDROP_KAVITA_DB=
INKDROP_KAVITA_COMIC_ROOT=/data/comics
INKDROP_KAVITA_MANGA_ROOT=/data/manga
INKDROP_KOMGA_URL=
INKDROP_SLSKD_API_BASE_URL=
INKDROP_SLSKD_API_KEY=
INKDROP_SLSKD_WEB_URL=
INKDROP_SLSKD_CONFIG=/config/slskd/slskd.yml
INKDROP_SLSKD_SEARCH_HISTORY_CLEANUP_ENABLED=false
INKDROP_SLSKD_SEARCH_HISTORY_KEEP=100
INKDROP_SLSKD_SEARCH_HISTORY_MAX_DELETE=5000
INKDROP_SLSKD_SEARCH_HISTORY_MIN_AGE_MINUTES=30
# Minimum seconds between new Soulseek-network searches (POST /searches) and
# a rolling hourly cap on how many can start. Protects the operator's
# Soulseek account from being flagged for search flooding; see
# enforce_slskd_search_pacing() in inkdrop_slskd_source_probe.py.
INKDROP_SLSKD_SEARCH_MIN_INTERVAL_SECONDS=5
INKDROP_SLSKD_SEARCH_MAX_PER_HOUR=60
INKDROP_PROWLARR_URL=
INKDROP_PROWLARR_API_KEY=
INKDROP_PROWLARR_CONFIG=/config/prowlarr/config.xml
INKDROP_PROWLARR_DB=/config/prowlarr/prowlarr.db
INKDROP_PROWLARR_PUBLIC_BASE_URL=
INKDROP_PROWLARR_INTERNAL_BASE_URLS=
INKDROP_SOURCE_WORKER_PROWLARR_ALLOWED_HOSTS=
INKDROP_TRUSTED_PROWLARR_HOSTS=
INKDROP_MYLAR_CONFIG=/config/mylar/config.ini
INKDROP_SABNZBD_URL=
INKDROP_SABNZBD_API_KEY=
INKDROP_QBITTORRENT_URL=
INKDROP_QBITTORRENT_USERNAME=
INKDROP_QBITTORRENT_PASSWORD=
INKDROP_QBITTORRENT_CONFIG=/config/qbit_manage/config.yml
INKDROP_QBITTORRENT_DOWNLOAD_ROOT=/staging/downloads
INKDROP_DOWNLOAD_STAGING_ROOT=/staging
INKDROP_UNC_PATH_MAPPINGS=
INKDROP_SAB_PATH_MAPPINGS=
INKDROP_SAB_RESCUE_SCRIPT=
INKDROP_UNRAR_PATH=/usr/bin/unrar-free
INKDROP_WEB_BASE_URL=
INKDROP_MANUAL_SOURCE_IMPORT_API_URL=
INKDROP_MARK_WAITING_API_URL=
